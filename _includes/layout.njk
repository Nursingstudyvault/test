<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>{% if title %}{{ title }} | Nursing Study Vault{% else %}Nursing Study Vault - Ready-made Nursing Practical Files{% endif %}</title>
    
    <meta name="description" content="{% if description %}{{ description }}{% else %}Nursing Study Vault provides ready-made nursing care plans, surgical care plans, case studies, health talks, procedures, assignments for ANM, GNM, BSc Nursing students. All content for educational purposes only.{% endif %}">
    
    <link rel="canonical" href="https://nursingstudyvault.online{{ page.url | url }}">
    
    <meta name="robots" content="index, follow">
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:title" content="{% if title %}{{ title }}{% else %}Nursing Study Vault{% endif %}">
    <meta property="og:description" content="{% if description %}{{ description }}{% else %}Ready-made nursing practical files for ANM, GNM, BSc Nursing students.{% endif %}">
    <meta property="og:url" content="https://nursingstudyvault.online{{ page.url | url }}">
    <meta property="og:type" content="{% if page.url == '/' %}website{% else %}article{% endif %}">
    <meta property="og:site_name" content="Nursing Study Vault">
    <meta property="og:locale" content="en_IN">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% if title %}{{ title }}{% else %}Nursing Study Vault{% endif %}">
    <meta name="twitter:description" content="{% if description %}{{ description }}{% else %}Ready-made nursing practical files for nursing students.{% endif %}">
    
    <!-- Schema.org Structured Data -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "{% if page.url == '/' %}WebSite{% else %}Article{% endif %}",
        "name": "{% if title %}{{ title }}{% else %}Nursing Study Vault{% endif %}",
        "description": "{% if description %}{{ description }}{% else %}Nursing practical files for ANM, GNM, BSc Nursing students{% endif %}",
        "url": "https://nursingstudyvault.online{{ page.url | url }}",
        "publisher": {
            "@type": "Organization",
            "name": "Nursing Study Vault"
        }
    }
    </script>
    
    <style>
        :root{--bg:#f0f4f8;--surface:#fff;--text:#333;--text-secondary:#666;--primary:#1a73e8;--accent:#ffd700;--border:#e0e0e0;--shadow:0 2px 10px rgba(0,0,0,.08);--sidebar-bg:#1a237e;--footer-bg:#1a237e;--disclaimer-bg:#fff3cd;--disclaimer-border:#ffc107;--disclaimer-text:#856404}
        [data-theme="dark"]{--bg:#121212;--surface:#1e1e1e;--text:#e0e0e0;--text-secondary:#b0b0b0;--primary:#4da3ff;--sidebar-bg:#0d1b3e;--footer-bg:#0d1b3e;--disclaimer-bg:#332b00;--disclaimer-text:#ffd700}
        *{margin:0;padding:0;box-sizing:border-box}
        body{font-family:'Segoe UI',system-ui,-apple-system,sans-serif;background:var(--bg);color:var(--text);line-height:1.7;font-size:clamp(0.95rem,2vw,1.05rem)}
        .medical-disclaimer-top{background:var(--disclaimer-bg);color:var(--disclaimer-text);text-align:center;padding:10px 15px;font-size:.85rem;border-bottom:2px solid var(--disclaimer-border)}
        .medical-disclaimer-top a{color:var(--primary);font-weight:600}
        .header{background:var(--primary);color:#fff;padding:15px 20px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:1000;box-shadow:0 2px 10px rgba(0,0,0,.15)}
        .logo{font-size:clamp(1.2rem,3vw,1.5rem);font-weight:700}.logo span{color:var(--accent)}
        .theme-toggle{background:rgba(255,255,255,.15);border:none;color:#fff;width:40px;height:40px;border-radius:50%;cursor:pointer;font-size:1.2rem}
        .hamburger{display:flex;flex-direction:column;cursor:pointer;gap:5px;padding:5px}
        .hamburger span{width:28px;height:3px;background:#fff;border-radius:3px;transition:all .3s}
        .hamburger.active span:nth-child(1){transform:rotate(45deg) translate(5px,6px)}
        .hamburger.active span:nth-child(2){opacity:0}
        .hamburger.active span:nth-child(3){transform:rotate(-45deg) translate(5px,-6px)}
        .sidebar{position:fixed;top:0;right:-300px;width:280px;height:100vh;background:var(--sidebar-bg);color:#fff;padding:80px 25px;transition:right .3s;z-index:999;overflow-y:auto;box-shadow:-5px 0 20px rgba(0,0,0,.3)}
        .sidebar.active{right:0}
        .sidebar h3{color:var(--accent);margin:18px 0 10px;text-transform:uppercase;font-size:1rem;letter-spacing:.5px}
        .sidebar a{display:block;color:#fff;text-decoration:none;padding:9px 8px;font-size:.95rem;border-radius:6px;transition:all .2s}
        .sidebar a:hover{color:var(--accent);background:rgba(255,255,255,.08);padding-left:14px}
        .overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.5);z-index:998;display:none}
        .overlay.active{display:block}
        .tagline-bar{background:#1557b0;color:#fff;text-align:center;padding:10px;font-size:.9rem}
        .breadcrumb{max-width:1000px;margin:20px auto;padding:0 20px;font-size:.9rem;color:var(--text-secondary)}
        .breadcrumb a{color:var(--primary);text-decoration:none}
        .page-container{max-width:1000px;margin:20px auto 40px;padding:0 20px}
        .category-header{background:var(--surface);border-radius:14px;padding:30px;box-shadow:0 4px 15px var(--shadow);margin-bottom:25px;text-align:center;border-top:5px solid var(--primary)}
        .category-header h1{color:var(--primary);font-size:clamp(1.4rem,3vw,2rem)}
        .post-list{display:flex;flex-direction:column;gap:15px}
        .post-card{background:var(--surface);border-radius:12px;padding:20px;box-shadow:0 3px 12px var(--shadow);border-left:4px solid var(--primary);display:flex;justify-content:space-between;align-items:center;gap:15px;transition:all .3s}
        .post-card:hover{transform:translateX(5px);border-left-color:var(--accent)}
        .post-info h3{color:var(--primary);font-size:1.1rem}
        .post-info .post-meta{color:var(--text-secondary);font-size:.85rem}
        .post-card .btn{background:var(--primary);color:#fff;padding:10px 18px;border-radius:8px;text-decoration:none;font-weight:600;white-space:nowrap}
        .post-card .btn:hover{opacity:.9}
        .content-area{background:var(--surface);border-radius:14px;padding:30px;box-shadow:0 4px 15px var(--shadow)}
        .content-area h2{color:#1557b0;border-left:5px solid var(--primary);padding-left:12px;margin:30px 0 15px}
        .content-area h3{color:var(--primary);margin:25px 0 10px}
        .content-area table{width:100%;border-collapse:collapse;margin:15px 0}
        .content-area th{background:var(--primary);color:#fff;padding:12px 15px;text-align:left}
        .content-area td{padding:10px 15px;border:1px solid var(--border)}
        .content-area tr:nth-child(even){background:#e8f0fe}
        [data-theme="dark"] .content-area tr:nth-child(even){background:#1a2a40}
        .table-wrapper{overflow-x:auto;-webkit-overflow-scrolling:touch;margin:15px 0;border-radius:10px;box-shadow:0 2px 10px var(--shadow)}
        .table-wrapper table{min-width:600px}
        .medical-disclaimer-bottom{background:var(--disclaimer-bg);color:var(--disclaimer-text);border:1px solid var(--disclaimer-border);border-radius:10px;padding:20px;margin:30px auto;text-align:center}
        .footer{background:var(--footer-bg);color:#fff;text-align:center;padding:25px 20px;margin-top:40px}
        .footer a{color:var(--accent);text-decoration:none}
        .footer a:hover{text-decoration:underline}
        .footer-links{margin:12px 0;display:flex;flex-wrap:wrap;justify-content:center;gap:15px}
        .footer-bottom{margin-top:12px;font-size:.85rem;opacity:.8}
        blockquote{background:var(--disclaimer-bg);color:var(--disclaimer-text);padding:15px 20px;border-left:5px solid var(--disclaimer-border);border-radius:5px;margin:15px 0}
        @media(max-width:768px){
            .post-card{flex-direction:column;text-align:center}
            .post-card .btn{width:100%;text-align:center}
            .content-area{padding:15px}
            .header{padding:12px 15px}
            .logo{font-size:1.1rem}
        }
    </style>
</head>
<body>
    <div class="overlay" id="overlay"></div>
    
    <div class="medical-disclaimer-top">
        ⚕️ <strong>Medical Disclaimer:</strong> All content is for <strong>educational purposes only</strong>. <a href="/pages/disclaimer.html">Read full disclaimer</a>
    </div>
    
    <aside class="sidebar" id="sidebar" aria-label="Navigation menu">
        <h3>📄 Info Pages</h3>
        <a href="/pages/about.html">📌 About Us</a>
        <a href="/pages/contact.html">📧 Contact Us</a>
        <a href="/pages/privacy-policy.html">🔒 Privacy Policy</a>
        <a href="/pages/terms.html">📜 Terms & Conditions</a>
        <a href="/pages/disclaimer.html">⚠️ Disclaimer</a>
        <h3>📂 Categories</h3>
        <a href="/pages/nursing-care-plan/">📋 Nursing Care Plan</a>
        <a href="/pages/surgical-care-plan/">🏥 Surgical Care Plan</a>
        <a href="/pages/case-study/">📖 Case Study</a>
        <a href="/pages/health-talk/">🗣️ Health Talk</a>
        <a href="/pages/health-education/">💊 Health Education</a>
        <a href="/pages/procedure/">🩺 Procedure</a>
        <a href="/pages/assignment/">📝 Assignment</a>
        <a href="/pages/nursing-notes/">📒 Nursing Notes</a>
        <a href="/pages/family-folder/">👨‍👩‍👧‍👦 Family Folder</a>
    </aside>
    
    <header class="header">
        <div class="logo">Nursing <span>Study</span> Vault</div>
        <div style="display:flex;align-items:center;gap:12px;">
            <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark/light theme">🌓</button>
            <div class="hamburger" id="hamburger" aria-label="Menu" role="button" tabindex="0">
                <span></span><span></span><span></span>
            </div>
        </div>
    </header>
    
    <div class="tagline-bar">Ready-made Nursing Practical Files for ANM • GNM • BSc Nursing Students</div>
    
    <div class="breadcrumb">
        <a href="/">🏠 Home</a> » {{ category | default("Page") }}
    </div>
    
    <main class="page-container">
        {{ content | safe }}
        <div class="medical-disclaimer-bottom">
            <h4>⚕️ Medical Disclaimer</h4>
            <p>The content on <strong>Nursing Study Vault</strong> is for <strong>educational purposes only</strong>. Not a substitute for professional medical advice, diagnosis, or treatment.</p>
        </div>
    </main>
    
    <footer class="footer">
        <p>&copy; 2026 <a href="/">Nursing Study Vault</a>. All rights reserved.</p>
        <div class="footer-links">
            <a href="/pages/about.html">About</a> | 
            <a href="/pages/contact.html">Contact</a> | 
            <a href="/pages/privacy-policy.html">Privacy Policy</a> | 
            <a href="/pages/terms.html">Terms</a> | 
            <a href="/pages/disclaimer.html">Disclaimer</a>
        </div>
        <div class="footer-bottom">
            <p>Designed for Nursing Students | ANM • GNM • BSc Nursing | <strong>Educational Purpose Only</strong></p>
        </div>
    </footer>
    
    <script>
        const html=document.documentElement;
        html.setAttribute('data-theme',localStorage.getItem('theme')||'light');
        document.getElementById('themeToggle').addEventListener('click',()=>{
            const t=html.getAttribute('data-theme')==='light'?'dark':'light';
            html.setAttribute('data-theme',t);
            localStorage.setItem('theme',t);
        });
        const hamburger=document.getElementById('hamburger'),
              sidebar=document.getElementById('sidebar'),
              overlay=document.getElementById('overlay');
        hamburger.addEventListener('click',()=>{
            hamburger.classList.toggle('active');
            sidebar.classList.toggle('active');
            overlay.classList.toggle('active');
            document.body.style.overflow=sidebar.classList.contains('active')?'hidden':'';
        });
        overlay.addEventListener('click',()=>{
            hamburger.classList.remove('active');
            sidebar.classList.remove('active');
            overlay.classList.remove('active');
            document.body.style.overflow='';
        });
        document.querySelectorAll('.sidebar a').forEach(link=>{
            link.addEventListener('click',()=>{
                hamburger.classList.remove('active');
                sidebar.classList.remove('active');
                overlay.classList.remove('active');
                document.body.style.overflow='';
            });
        });
        hamburger.addEventListener('keydown',(e)=>{
            if(e.key==='Enter'||e.key===' '){e.preventDefault();hamburger.click();}
        });
    </script>
</body>
</html>
