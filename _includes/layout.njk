<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
<title>
{% if title %}
{{ title }} | Nursing Study Vault
{% else %}
Nursing Study Vault
{% endif %}
</title>

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<meta name="description" content="{% if description %}{{ description }}{% else %}Nursing practical files, health talks, nursing notes, procedures, case studies and care plans for ANM GNM and BSc Nursing students.{% endif %}">

<link rel="canonical" href="https://nursingstudyvault.online{{ page.url }}">

<meta name="robots" content="index, follow">

<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{% if description %}{{ description }}{% else %}Nursing Study Vault{% endif %}">
<meta property="og:type" content="article">
<meta property="og:url" content="https://nursingstudyvault.online{{ page.url }}">
<meta property="og:site_name" content="Nursing Study Vault">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} - Nursing Study Vault</title>
<link rel="stylesheet" href="/assets/style.css">
    <meta name="description" content="{{ description }}">
    <style>
        :root { --bg: #f0f4f8; --surface: #ffffff; --text: #333; --text-secondary: #666; --primary: #1a73e8; --accent: #ffd700; --border: #e0e0e0; --shadow: rgba(0,0,0,0.08); --sidebar-bg: #1a237e; --footer-bg: #1a237e; --disclaimer-bg: #fff3cd; --disclaimer-border: #ffc107; --disclaimer-text: #856404; }
        [data-theme="dark"] { --bg: #121212; --surface: #1e1e1e; --text: #e0e0e0; --text-secondary: #b0b0b0; --primary: #4da3ff; --sidebar-bg: #0d1b3e; --footer-bg: #0d1b3e; --disclaimer-bg: #332b00; --disclaimer-text: #ffd700; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', system-ui, sans-serif; background: var(--bg); color: var(--text); line-height: 1.7; }
        .medical-disclaimer-top { background: var(--disclaimer-bg); color: var(--disclaimer-text); text-align: center; padding: 10px; font-size: 0.85rem; border-bottom: 2px solid var(--disclaimer-border); }
        .medical-disclaimer-top a { color: var(--primary); font-weight: 600; }
        .header { background: var(--primary); color: white; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 1000; }
        .logo { font-size: 1.5rem; font-weight: bold; } .logo span { color: var(--accent); }
        .theme-toggle { background: rgba(255,255,255,0.15); border: none; color: white; width: 40px; height: 40px; border-radius: 50%; cursor: pointer; font-size: 1.2rem; }
        .hamburger { display: flex; flex-direction: column; cursor: pointer; gap: 5px; }
        .hamburger span { width: 28px; height: 3px; background: white; border-radius: 3px; }
        .sidebar { position: fixed; top: 0; right: -300px; width: 280px; height: 100vh; background: var(--sidebar-bg); color: white; padding: 80px 25px; transition: right 0.3s; z-index: 999; overflow-y: auto; }
        .sidebar.active { right: 0; }
        .sidebar h3 { color: var(--accent); margin: 18px 0 10px; text-transform: uppercase; font-size: 1rem; }
        .sidebar a { display: block; color: white; text-decoration: none; padding: 9px; }
        .sidebar a:hover { color: var(--accent); }
        .overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 998; display: none; }
        .overlay.active { display: block; }
        .tagline-bar { background: #1557b0; color: white; text-align: center; padding: 10px; font-size: 0.9rem; }
        .breadcrumb { max-width: 1000px; margin: 20px auto; padding: 0 20px; }
        .breadcrumb a { color: var(--primary); text-decoration: none; }
        .page-container { max-width: 1000px; margin: 20px auto 40px; padding: 0 20px; }
        .category-header { background: var(--surface); border-radius: 14px; padding: 30px; box-shadow: 0 4px 15px var(--shadow); margin-bottom: 25px; text-align: center; border-top: 5px solid var(--primary); }
        .category-header h1 { color: var(--primary); }
        .post-list { display: flex; flex-direction: column; gap: 15px; }
        .post-card { background: var(--surface); border-radius: 12px; padding: 20px; box-shadow: 0 3px 12px var(--shadow); border-left: 4px solid var(--primary); display: flex; justify-content: space-between; align-items: center; }
        .post-card .btn { background: var(--primary); color: white; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: 600; }
        .medical-disclaimer-bottom { background: var(--disclaimer-bg); color: var(--disclaimer-text); border-radius: 10px; padding: 20px; margin: 30px auto; text-align: center; }
        .footer { background: var(--footer-bg); color: white; text-align: center; padding: 25px; margin-top: 40px; }
        .footer a { color: var(--accent); text-decoration: none; }
        .footer-links { margin: 12px 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 15px; }
        @media (max-width: 768px) { .post-card { flex-direction: column; text-align: center; } }
    </style>
</head>
<body>
    <div class="overlay" id="overlay"></div>
    <div class="medical-disclaimer-top">⚕️ <strong>Medical Disclaimer:</strong> All content is for <strong>educational purposes only</strong>. <a href="/pages/disclaimer.html" style="color:var(--primary);">Read full disclaimer</a></div>
    <aside class="sidebar" id="sidebar">
        <h3>Info Pages</h3>
        <a href="/pages/about.html">About Us</a>
        <a href="/pages/contact.html">Contact Us</a>
        <a href="/pages/privacy-policy.html">Privacy Policy</a>
        <a href="/pages/terms.html">Terms</a>
        <a href="/pages/disclaimer.html">Disclaimer</a>
        <h3>Categories</h3>
        <a href="/pages/nursing-care-plan/">Nursing Care Plan</a>
        <a href="/pages/surgical-care-plan/">Surgical Care Plan</a>
        <a href="/pages/case-study/">Case Study</a>
        <a href="/pages/health-talk/">Health Talk</a>
        <a href="/pages/health-education/">Health Education</a>
        <a href="/pages/procedure/">Procedure</a>
        <a href="/pages/assignment/">Assignment</a>
        <a href="/pages/nursing-notes/">Nursing Notes</a>
        <a href="/pages/family-folder/">Family Folder</a>
    </aside>
    <header class="header">
        <div class="logo">Nursing <span>Study</span> Vault</div>
        <div style="display:flex;align-items:center;gap:12px;">
            <button class="theme-toggle" id="themeToggle">🌓</button>
            <div class="hamburger" id="hamburger"><span></span><span></span><span></span></div>
        </div>
    </header>
    <div class="tagline-bar">Ready-made Nursing Practical Files for ANM | GNM | BSc Nursing Students</div>
    <div class="breadcrumb"><a href="/">Home</a> &raquo; {{ category }}</div>
    <main class="page-container">
        {{ content | safe }}
        <div class="medical-disclaimer-bottom"><h4>⚕️ Medical Disclaimer</h4><p>The content on <strong>Nursing Study Vault</strong> is for <strong>educational purposes only</strong>.</p></div>
    </main>
    <footer class="footer">
        <p>&copy; 2026 <a href="/">Nursing Study Vault</a>. All rights reserved.</p>
        <div class="footer-links">
            <a href="/pages/about.html">About</a> | <a href="/pages/contact.html">Contact</a> | <a href="/pages/privacy-policy.html">Privacy Policy</a> | <a href="/pages/terms.html">Terms</a> | <a href="/pages/disclaimer.html">Disclaimer</a>
        </div>
        <p style="margin-top:8px;font-size:0.85rem;">Designed for Nursing Students | <strong>Educational Purpose Only</strong></p>
    </footer>
    <script>
        var h=document.documentElement;h.setAttribute('data-theme',localStorage.getItem('theme')||'light');
        document.getElementById('themeToggle').addEventListener('click',function(){var t=h.getAttribute('data-theme')==='light'?'dark':'light';h.setAttribute('data-theme',t);localStorage.setItem('theme',t);});
        var mb=document.getElementById('hamburger'),sb=document.getElementById('sidebar'),ov=document.getElementById('overlay');
        mb.addEventListener('click',function(){mb.classList.toggle('active');sb.classList.toggle('active');ov.classList.toggle('active');});
        ov.addEventListener('click',function(){mb.classList.remove('active');sb.classList.remove('active');ov.classList.remove('active');});
    </script>
</body>
</html>
