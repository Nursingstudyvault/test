<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="icon" type="image/png" href="/assets/favicon.png">
    <link rel="apple-touch-icon" href="/assets/favicon.png">

    <title>{% if title %}{{ title }} | Nursing Study Vault{% else %}Nursing Study Vault - Ready-made Nursing Practical Files{% endif %}</title>
    <meta name="description" content="{% if description %}{{ description }}{% else %}Ready-made nursing practical files, care plans, case studies, health talks, procedures and assignments for ANM, GNM and BSc Nursing students.{% endif %}">

    <link rel="canonical" href="https://nursingstudyvault.online{{ page.url | url }}">
    <link rel="stylesheet" href="/assets/style.css">

    <meta name="robots" content="index, follow">
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large">
    <meta name="google-site-verification" content="z7u5PuixJWx9ckg5CxUl9naUnZsTce9yob5bG6lOv9s">

    <meta property="og:title" content="{% if title %}{{ title }}{% else %}Nursing Study Vault{% endif %}">
    <meta property="og:description" content="{% if description %}{{ description }}{% else %}Ready-made nursing practical files for nursing students.{% endif %}">
    <meta property="og:url" content="https://nursingstudyvault.online{{ page.url | url }}">
    <meta property="og:type" content="{% if page.url == '/' %}website{% else %}article{% endif %}">
    <meta property="og:site_name" content="Nursing Study Vault">
    <meta property="og:image" content="{% if image %}https://nursingstudyvault.online{{ image }}{% else %}https://nursingstudyvault.online/assets/favicon.png{% endif %}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{% if title %}{{ title }}{% else %}Nursing Study Vault{% endif %}">
    <meta name="twitter:description" content="{% if description %}{{ description }}{% else %}Ready-made nursing practical files for nursing students.{% endif %}">
    <meta name="twitter:image" content="{% if image %}https://nursingstudyvault.online{{ image }}{% else %}https://nursingstudyvault.online/assets/favicon.png{% endif %}">

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "{% if page.url == '/' %}WebSite{% else %}Article{% endif %}",
      "name": "{% if title %}{{ title }}{% else %}Nursing Study Vault{% endif %}",
      "description": "{% if description %}{{ description }}{% else %}Nursing practical files for ANM, GNM and BSc Nursing students{% endif %}",
      "url": "https://nursingstudyvault.online{{ page.url | url }}",
      "publisher": {
        "@type": "Organization",
        "name": "Nursing Study Vault",
        "logo": {
          "@type": "ImageObject",
          "url": "https://nursingstudyvault.online/assets/favicon.png"
        }
      }
    }
    </script>
</head>

<body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="overlay" id="overlay"></div>

    <div class="medical-disclaimer-top">
        ⚕️ <strong>Medical Disclaimer:</strong> All content is for <strong>educational purposes only</strong>.
        <a href="/pages/disclaimer/">Read full disclaimer</a>
    </div>

    <aside class="sidebar" id="sidebar" aria-label="Navigation menu">
        <h3>📄 Info Pages</h3>
        <a href="/pages/about/">📌 About Us</a>
        <a href="/pages/contact/">📧 Contact Us</a>
        <a href="/pages/privacy-policy/">🔒 Privacy Policy</a>
        <a href="/pages/terms/">📜 Terms & Conditions</a>
        <a href="/pages/disclaimer/">⚠️ Disclaimer</a>

        <h3>📂 Categories</h3>
        <a href="/pages/nursing-care-plan/">📋 Nursing Care Plan</a>
        <a href="/pages/surgical-care-plan/">🏥 Surgical Care Plan</a>
        <a href="/pages/case-study/">📖 Case Study</a>
        <a href="/pages/health-talk/">🗣️ Health Talk</a>
        <a href="/pages/health-education/">💊 Health Education</a>
        <a href="/pages/procedure/">🩺 Procedure</a>
        <a href="/pages/assignment/">📝 Assignment</a>
        <a href="/pages/nursing-notes/">📒 Nursing Notes</a>
        <a href="/pages/family-folder/">👨‍👩‍👧‍👦 Family Folder</a>
    </aside>

    <header class="header">
        <div class="header-left">
            <a class="brand-link" href="/" aria-label="Nursing Study Vault Home">
                <img src="/assets/favicon.png" alt="Nursing Study Vault Logo" class="site-logo">
                <div class="logo">Nursing <span>Study</span> Vault</div>
            </a>
        </div>

        <div class="header-right">
            <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark/light theme">🌓</button>
            <button class="hamburger" id="hamburger" aria-label="Open menu" type="button">
                <span></span><span></span><span></span>
            </button>
        </div>
    </header>

    <div class="tagline-bar">Ready-made Nursing Practical Files for ANM • GNM • BSc Nursing Students</div>

    <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">🏠 Home</a> » {{ category | default("Page") }}
    </nav>

    <main class="page-container" id="main-content">
        <div class="content-area">
            {{ content | safe }}
        </div>

        {% include "related.njk" %}

        <div class="medical-disclaimer-bottom">
            <h4>⚕️ Medical Disclaimer</h4>
            <p>The content on <strong>Nursing Study Vault</strong> is for <strong>educational purposes only</strong> and not a substitute for professional medical advice.</p>
        </div>
    </main>

    <footer class="footer">
        <p>&copy; 2026 <a href="/">Nursing Study Vault</a>. All rights reserved.</p>

        <div class="footer-links">
            <a href="/pages/about/">About</a>
            <a href="/pages/contact/">Contact</a>
            <a href="/pages/privacy-policy/">Privacy Policy</a>
            <a href="/pages/terms/">Terms</a>
            <a href="/pages/disclaimer/">Disclaimer</a>
        </div>

        <div class="footer-bottom">
            <p>Designed for Nursing Students | ANM • GNM • BSc Nursing | <strong>Educational Purpose Only</strong></p>
            <p class="version">Version 1.1</p>
        </div>
    </footer>

    <script>
        const html = document.documentElement;
        html.setAttribute('data-theme', localStorage.getItem('theme') || 'light');

        document.getElementById('themeToggle').addEventListener('click', () => {
            const t = html.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
            html.setAttribute('data-theme', t);
            localStorage.setItem('theme', t);
        });

        const h = document.getElementById('hamburger');
        const s = document.getElementById('sidebar');
        const o = document.getElementById('overlay');

        function closeMenu() {
            h.classList.remove('active');
            s.classList.remove('active');
            o.classList.remove('active');
            h.setAttribute('aria-label', 'Open menu');
        }

        h.addEventListener('click', () => {
            h.classList.toggle('active');
            s.classList.toggle('active');
            o.classList.toggle('active');
            h.setAttribute('aria-label', h.classList.contains('active') ? 'Close menu' : 'Open menu');
        });

        o.addEventListener('click', closeMenu);
        document.querySelectorAll('.sidebar a').forEach(l => l.addEventListener('click', closeMenu));
    </script>
</body>
</html>
