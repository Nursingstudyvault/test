{% if relatedPosts | length > 0 %}
<div class="related-posts" style="margin-top:40px;">
    <h2 style="color:var(--primary-dark);border-left:5px solid var(--primary);padding-left:12px;margin-bottom:20px;">📂 Related Posts</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:15px;">
        {% for post in relatedPosts %}
        <a href="{{ post.url }}" style="background:var(--surface);border-radius:12px;padding:20px;box-shadow:var(--shadow);border-left:4px solid var(--primary);text-decoration:none;color:var(--text);transition:var(--transition);display:block;">
            <h3 style="color:var(--primary);font-size:1rem;margin-bottom:5px;">{{ post.data.title }}</h3>
            <span style="color:var(--text-secondary);font-size:0.8rem;">📅 {{ post.date | date: "%B %d, %Y" }}</span>
        </a>
        {% endfor %}
    </div>
</div>
{% endif %}
